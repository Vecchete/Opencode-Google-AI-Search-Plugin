{
  "name": "opencode-google-ai-search-plugin",
  "version": "0.3.0",
  "description": "An opencode plugin that exposes a Google AI Mode search tool.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run compile && node --test tests/*.test.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "google",
    "ai",
    "search"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "latest",
    "turndown": "latest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "latest"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode/plugin": "^2.1.2",
    "@types/turndown": "^5.0.6",
    "typescript": "latest"
  }
}
